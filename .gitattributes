# Fins de ligne : sans ce fichier, git sous Windows (core.autocrlf=true) convertirait les scripts
# Linux en CRLF et ils ne fonctionneraient plus pour ceux qui clonent le projet sous Linux.
* text=auto
*.sh       text eol=lf
*.desktop  text eol=lf
*.py       text eol=lf
*.pyw      text eol=lf
*.spec     text eol=lf
*.md       text eol=lf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.iss      text eol=crlf

*.ico binary
*.png binary
